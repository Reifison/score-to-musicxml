NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/score_to_musicxml?schema=public
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=score_session
SESSION_SECRET=replace-with-a-long-random-secret
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
SCORE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
FREE_SCAN_LIMIT=3
APPLE_PREMIUM_PRODUCT_ID=premium_unlock
APPLE_BUNDLE_ID=com.scoretomusicxml.app
APPLE_APP_APPLE_ID=
APPLE_IAP_ENVIRONMENT=sandbox
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_ROOT_CERT_PATHS=
CLAMAV_BIN=
REQUIRE_MALWARE_SCAN=false
OMR_ENGINE=stub
AUDIVERIS_BIN=/Applications/Audiveris.app/Contents/MacOS/Audiveris
OMR_CONVERSION_TIMEOUT_MS=900000
OMR_AUDIVERIS_TIMEOUT_MS=600000
OMR_WORKER_CONCURRENCY=1
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
