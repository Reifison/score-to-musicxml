# Domínios públicos (usados pelo Caddy para HTTPS automático)
API_DOMAIN=api.seudominio.com
WEB_DOMAIN=app.seudominio.com
VITE_API_URL=https://api.seudominio.com

# Banco e cache (valores internos do docker-compose.prod.yml)
POSTGRES_DB=score_to_musicxml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgresql://postgres:troque-por-uma-senha-forte@postgres:5432/score_to_musicxml?schema=public
REDIS_URL=redis://redis:6379

# API
NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://app.seudominio.com
SESSION_COOKIE_NAME=score_session
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
STORAGE_DIR=/app/storage
MAX_UPLOAD_BYTES=10485760
SCORE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
FREE_SCAN_LIMIT=3

# Admin inicial (usado pelo seed manual após o primeiro deploy)
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=TroquePorUmaSenhaForte123!

# OMR: a imagem de produção instala Audiveris Linux e os idiomas OCR.
OMR_ENGINE=audiveris
AUDIVERIS_BIN=/opt/audiveris/bin/Audiveris
OMR_CONVERSION_TIMEOUT_MS=900000
OMR_AUDIVERIS_TIMEOUT_MS=600000
OMR_WORKER_CONCURRENCY=1

# Apple In-App Purchase (produção)
APPLE_PREMIUM_PRODUCT_ID=premium_unlock
APPLE_BUNDLE_ID=com.scoretomusicxml.app
APPLE_APP_APPLE_ID=
APPLE_IAP_ENVIRONMENT=production
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_ROOT_CERT_PATHS=
GOOGLE_PLAY_PACKAGE_NAME=com.scoretomusicxml.app
GOOGLE_PLAY_PRODUCT_ID=premium_unlock
GOOGLE_PLAY_VALIDATION_ENABLED=1
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_RTDN_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

REQUIRE_MALWARE_SCAN=false
BCRYPT_ROUNDS=12
