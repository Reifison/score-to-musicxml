{
  "expo": {
    "name": "Conversor de Partituras",
    "slug": "score-to-musicxml",
    "scheme": "scoretomusicxml",
    "version": "1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.scoretomusicxml.app",
      "icon": "./assets/icon.png",
      "buildNumber": "10",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Usamos a camera para escanear partituras e enviar ao conversor.",
        "NSPhotoLibraryUsageDescription": "Usamos sua biblioteca para selecionar fotos de partituras.",
        "NSPhotoLibraryAddUsageDescription": "O app pode salvar arquivos temporarios exportados quando voce escolher compartilhar."
      }
    },
    "android": {
      "package": "com.scoretomusicxml.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#faf8f4"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#faf8f4"
        }
      ],
      "./plugins/withIOSSceneLifecycle",
      "./plugins/withAndroidPlayerAssets",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecione fotos de partituras para converter em MusicXML.",
          "cameraPermission": "Tire fotos de partituras para converter em MusicXML.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "${EXPO_PUBLIC_API_URL}"
    }
  }
}
