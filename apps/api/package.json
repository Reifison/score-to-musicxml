{
  "name": "@score-to-musicxml/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/conversionWorker.ts",
    "worker:start": "node dist/workers/conversionWorker.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "test": "NODE_ENV=test vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.51.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "multer": "^2.1.1",
    "nanoid": "^5.1.5",
    "sharp": "^0.34.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "vitest": "^3.1.2"
  }
}
